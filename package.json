{
  "name": "xcentral",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:mrz && npm run test:dataset && npm run test:capture && npm run test:vision && npm run test:db",
    "test:mrz": "node --experimental-strip-types supabase/functions/_shared/mrz.test.ts",
    "test:dataset": "node tests/run-dataset.mjs",
    "test:db": "./scripts/test-db.sh",
    "test:capture": "node tests/run-capture-metrics.mjs",
    "test:wizard": "npm run build && node tests/run-onboarding-wizard.mjs",
    "test:console": "npm run build && node tests/run-console-pages.mjs",
    "build:single": "vite build --config vite.config.singlefile.js && node scripts/build-single-file.mjs",
    "test:single": "npm run build:single && node tests/run-single-file.mjs",
    "build:vision": "vite build --config vite.config.vision.js",
    "test:vision": "npm run build:vision && node tests/run-vision.mjs",
    "dev:lan": "node scripts/dev-lan.mjs",
    "test:browser": "npm run build && node tests/run-console-pages.mjs && node tests/run-onboarding-wizard.mjs && npm run test:vision && npm run test:single"
  },
  "devDependencies": {
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.4"
  }
}
