# Console (Vite) — publishable values, safe in the bundle.
# Access control is row level security and the edge functions, not secrecy.
VITE_SUPABASE_URL_SANDBOX=https://your-sandbox-project.supabase.co
VITE_SUPABASE_KEY_SANDBOX=sb_publishable_xxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_URL_PRODUCTION=
VITE_SUPABASE_KEY_PRODUCTION=

# ── Edge function secrets (supabase secrets set …) ──────────────
# NOT for this file in a real deployment — listed here so the set is
# discoverable. Never commit real values.

# Required. Identity hashing refuses to run without it, because an
# unpeppered SHA-256 of a 13-digit ID number is reversible by brute
# force in minutes.
ID_HASH_PEPPER=

# Authenticate the scheduled jobs.
WEBHOOK_DISPATCH_SECRET=
RETENTION_PURGE_SECRET=

# Provider routing. Defaults to 'simulation' everywhere, which is
# fenced off from production platforms.
XCENTRAL_PROVIDER_DEFAULT=simulation
XCENTRAL_PROVIDER_IDENTITY=
XCENTRAL_PROVIDER_DOCUMENT=
XCENTRAL_PROVIDER_CREDIT=
XCENTRAL_PROVIDER_BIOMETRIC=

# Only ever set this to deliberately drill the simulation against a
# production platform. It exists so that doing so is a decision.
XCENTRAL_ALLOW_SIMULATION_IN_PROD=
